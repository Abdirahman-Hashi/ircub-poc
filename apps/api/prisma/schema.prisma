// IRCUB POC — Prisma schema.
//
// Phase 0 contains only the foundation: enums mirrored from packages/shared/src/enums.ts,
// the SystemConfig table (runtime-tunable business parameters) and the ControlNumber
// sequence (docs/DECISIONS.md D10). Business models arrive with their phase, each as a new
// migration; migrations are never edited after commit (standards §6).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (keep in sync with @ircub/shared enums.ts) ────────────────────────

enum Currency {
  SOS
  USD
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum PayerType {
  INDIVIDUAL
  BUSINESS
}

enum PayerStatus {
  ACTIVE
  SUSPENDED
}

enum DuplicateMatchField {
  PHONE
  EMAIL
  NATIONAL_ID
}

enum DuplicateFlagStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

enum RateType {
  FIXED
  PERCENT
}

enum AssessmentStatus {
  PENDING
  PART_PAID
  PAID
  CANCELLED
}

enum PaymentChannel {
  CASH
  BANK
  MOBILE_MONEY
  BULK
}

enum PaymentStatus {
  INITIATED
  PENDING
  CONFIRMED
  FAILED
  PERMANENTLY_FAILED
  REVERSED
}

enum ReversalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum BulkUploadKind {
  REVENUE_TRANSACTIONS
  METER_READINGS
}

enum ReadingType {
  NORMAL
  ROLLOVER
  REPLACEMENT
}

enum ReadingSource {
  MANUAL
  CSV
}

enum MeterStatus {
  ACTIVE
  REPLACED
  FAULTY
}

enum WaterAccountStatus {
  ACTIVE
  DISCONNECTED
}

enum BillingCycleStatus {
  DRAFT
  REVIEW
  RELEASED
}

enum BillStatus {
  DRAFT
  FLAGGED
  RELEASED
  PART_PAID
  PAID
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum ReconciliationLineStatus {
  MATCHED
  MISSING_IN_IRCUB
  MISSING_IN_CHANNEL
  AMOUNT_MISMATCH
}

enum JournalBatchKind {
  COLLECTIONS
  REVERSAL
}

enum JournalBatchStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
}

enum FmisReconciliationStatus {
  MATCHED
  MISMATCH
  MISSING_IN_FMIS
}

enum AlertType {
  COLLECTION_DROP
  REVERSAL_SPIKE
  PAYMENT_PERMANENTLY_FAILED
  FMIS_BATCH_FAILED
  ABNORMAL_CONSUMPTION
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ControlNumberPurpose {
  ASSESSMENT
  BILL
}

// ─── Identity & access (phase 1, D5–D7) ──────────────────────────────────────

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  passwordHash      String     @map("password_hash")
  fullName          String     @map("full_name")
  status            UserStatus @default(ACTIVE)
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  /// Base32 TOTP secret; set at enrolment, cleared on disable. Redacted in audit rows.
  mfaSecret         String?    @map("mfa_secret")
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at")
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until")
  /// Links a Taxpayer/Customer user to their payer record (self-service scope).
  payerId           String?    @map("payer_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  payer           Payer?            @relation(fields: [payerId], references: [id], onDelete: SetNull)
  roles           UserRole[]
  passwordHistory PasswordHistory[]
  refreshTokens   RefreshToken[]
  bulkUploads     BulkUpload[]

  @@index([status])
  @@map("user")
}

/// Previous password hashes so a user cannot reuse the last N (D5).
model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

/// Opaque refresh tokens stored hashed; rotated on use, revoked on logout/reuse (D5).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  /// Set when the token was exchanged for a new one; presenting it again means theft.
  rotatedAt DateTime? @map("rotated_at")
  /// Set on logout, deactivation, password change or reuse detection.
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  /// A role inherits every permission of its parent, recursively (D6).
  parentId    String? @map("parent_id") @db.Uuid
  isSystem    Boolean @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent      Role?            @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Role[]           @relation("RoleHierarchy")
  permissions RolePermission[]
  users       UserRole[]

  @@index([parentId])
  @@map("role")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  /// `resource.action`, one row per code in @ircub/shared PERMISSIONS.
  code        String @unique
  description String
  group       String

  roles RolePermission[]

  @@index([group])
  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

/// A user may never hold both permissions, through any combination of roles (D7).
model SodRule {
  id              String   @id @default(uuid()) @db.Uuid
  permissionACode String   @map("permission_a_code")
  permissionBCode String   @map("permission_b_code")
  description     String
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([permissionACode, permissionBCode])
  @@map("sod_rule")
}

// ─── Registry & revenue (phase 2, D9–D12) ────────────────────────────────────

model Payer {
  id             String      @id @default(uuid()) @db.Uuid
  /// `TIN` + 9 digits + mod-11 check digit (D10), generated server-side.
  tin            String      @unique
  type           PayerType
  name           String
  nationalId     String?     @map("national_id")
  registrationNo String?     @map("registration_no")
  /// Stored normalised (E.164) so duplicate detection is an exact match.
  phone          String
  /// Stored lower-cased.
  email          String?
  address        String?
  status         PayerStatus @default(ACTIVE)
  createdById    String      @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  users          User[]
  assessments    Assessment[]
  payments       Payment[]
  duplicateFlags DuplicateFlag[] @relation("FlaggedPayer")
  matchedBy      DuplicateFlag[] @relation("MatchedPayer")

  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([nationalId])
  @@index([status, type])
  @@map("payer")
}

/// A possible duplicate found at registration; reviewed by a supervisor.
model DuplicateFlag {
  id             String              @id @default(uuid()) @db.Uuid
  payerId        String              @map("payer_id") @db.Uuid
  matchedPayerId String              @map("matched_payer_id") @db.Uuid
  matchField     DuplicateMatchField @map("match_field")
  status         DuplicateFlagStatus @default(PENDING)
  reviewedById   String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?           @map("reviewed_at")
  note           String?
  createdAt      DateTime            @default(now()) @map("created_at")

  payer        Payer @relation("FlaggedPayer", fields: [payerId], references: [id], onDelete: Cascade)
  matchedPayer Payer @relation("MatchedPayer", fields: [matchedPayerId], references: [id], onDelete: Cascade)

  @@unique([payerId, matchedPayerId, matchField])
  @@index([status])
  @@index([matchedPayerId])
  @@map("duplicate_flag")
}

model RevenueType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  rateType    RateType @map("rate_type")
  /// FIXED: amount in local currency. PERCENT: percentage of baseAmount.
  rate        Decimal  @db.Decimal(18, 2)
  /// General ledger code used by FMIS posting (phase 5 adds dated mappings).
  glCode      String   @map("gl_code")
  active      Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assessments Assessment[]

  @@index([active])
  @@map("revenue_type")
}

model Assessment {
  id            String           @id @default(uuid()) @db.Uuid
  /// 12 digits, last two mod-97 check digits, unique across assessments and bills (D10).
  controlNumber String           @unique @map("control_number")
  payerId       String           @map("payer_id") @db.Uuid
  revenueTypeId String           @map("revenue_type_id") @db.Uuid
  /// e.g. `2026`, `2026-Q1`, `2026-03` — free text the revenue type dictates.
  period        String?
  baseAmount    Decimal?         @map("base_amount") @db.Decimal(18, 2)
  amount        Decimal          @db.Decimal(18, 2)
  currency      Currency         @default(SOS)
  dueDate       DateTime         @map("due_date")
  status        AssessmentStatus @default(PENDING)
  paidAmount    Decimal          @default(0) @map("paid_amount") @db.Decimal(18, 2)
  createdById   String           @map("created_by_id") @db.Uuid
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  payer       Payer       @relation(fields: [payerId], references: [id], onDelete: Restrict)
  revenueType RevenueType @relation(fields: [revenueTypeId], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@index([payerId])
  @@index([revenueTypeId])
  @@index([status])
  @@index([createdAt])
  @@index([dueDate])
  @@index([amount])
  @@map("assessment")
}

model Payment {
  id                  String         @id @default(uuid()) @db.Uuid
  controlNumber       String         @map("control_number")
  assessmentId        String?        @map("assessment_id") @db.Uuid
  /// Bill FK added in phase 3.
  billId              String?        @map("bill_id") @db.Uuid
  payerId             String         @map("payer_id") @db.Uuid
  channel             PaymentChannel
  channelTxnRef       String?        @map("channel_txn_ref")
  amount              Decimal        @db.Decimal(18, 2)
  currency            Currency
  /// Rate from `currency` to local currency at capture time; 1 for local payments (D9).
  fxRate              Decimal        @default(1) @map("fx_rate") @db.Decimal(18, 6)
  fxRateAt            DateTime?      @map("fx_rate_at")
  localAmount         Decimal        @map("local_amount") @db.Decimal(18, 2)
  status              PaymentStatus
  statusCheckAttempts Int            @default(0) @map("status_check_attempts")
  paidAt              DateTime?      @map("paid_at")
  capturedById        String?        @map("captured_by_id") @db.Uuid
  bulkUploadId        String?        @map("bulk_upload_id") @db.Uuid
  callbackPayload     Json?          @map("callback_payload")
  failureReason       String?        @map("failure_reason")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  payer      Payer       @relation(fields: [payerId], references: [id], onDelete: Restrict)
  bulkUpload BulkUpload? @relation(fields: [bulkUploadId], references: [id], onDelete: SetNull)
  reversals  Reversal[]

  /// Duplicate channel callbacks and duplicate bulk rows are no-ops at the database (D11).
  @@unique([channel, channelTxnRef])
  @@index([payerId])
  @@index([assessmentId])
  @@index([controlNumber])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@index([paidAt])
  @@index([localAmount])
  @@map("payment")
}

model Reversal {
  id           String         @id @default(uuid()) @db.Uuid
  paymentId    String         @map("payment_id") @db.Uuid
  reason       String
  capturedById String         @map("captured_by_id") @db.Uuid
  status       ReversalStatus @default(PENDING_APPROVAL)
  approvedById String?        @map("approved_by_id") @db.Uuid
  decidedAt    DateTime?      @map("decided_at")
  decisionNote String?        @map("decision_note")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status])
  @@index([capturedById])
  @@map("reversal")
}

/// One row per upload: the file is kept on disk for the audit trail, the summary in JSON (D12).
model BulkUpload {
  id           String         @id @default(uuid()) @db.Uuid
  kind         BulkUploadKind
  fileName     String         @map("file_name")
  storedPath   String         @map("stored_path")
  totalRows    Int            @map("total_rows")
  accepted     Int
  rejected     Int
  summary      Json
  uploadedById String         @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")

  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  payments   Payment[]

  @@index([kind, createdAt])
  @@map("bulk_upload")
}

/// Exchange-rate history (D9). Phase 4 refreshes it from the mock FX API.
model FxRate {
  id     String   @id @default(uuid()) @db.Uuid
  base   Currency
  quote  Currency
  rate   Decimal  @db.Decimal(18, 6)
  asOf   DateTime @map("as_of")
  source String

  @@index([base, quote, asOf])
  @@map("fx_rate")
}

// ─── Audit (D8) ──────────────────────────────────────────────────────────────

/// Append-only, hash-chained record of every mutation of an audited model.
/// The API never updates or deletes rows; production hardening grants INSERT+SELECT only.
model AuditLog {
  id         BigInt      @id @default(autoincrement())
  /// Contiguous sequence allocated under the chain-head lock; the chain is verified in seq order.
  seq        BigInt      @unique
  actorId    String?     @map("actor_id") @db.Uuid
  actorEmail String      @map("actor_email")
  entity     String
  entityId   String      @map("entity_id")
  action     AuditAction
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")
  prevHash   String      @map("prev_hash") @db.Char(64)
  hash       String      @db.Char(64)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

/// Single row holding the tail of the chain; locked FOR UPDATE while a row is appended so
/// concurrent writers serialise and prevHash/seq stay consistent.
model AuditChainHead {
  id       Int    @id @default(1)
  lastSeq  BigInt @default(0) @map("last_seq")
  lastHash String @map("last_hash") @db.Char(64)

  @@map("audit_chain_head")
}

// ─── Foundation models ───────────────────────────────────────────────────────

/// Runtime-tunable business parameters (standards §1). Keys and typed defaults live in
/// apps/api/src/modules/system-config/system-config.keys.ts; the seed inserts the defaults.
model SystemConfig {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("system_config")
}

/// Single sequence shared by assessments and bills so a control number is unique across both
/// (D10). The row id becomes the 10-digit body; two mod-97 check digits are appended.
model ControlNumber {
  id        BigInt               @id @default(autoincrement())
  purpose   ControlNumberPurpose
  createdAt DateTime             @default(now()) @map("created_at")

  @@map("control_number")
}
