}

// ─── Identity & access (phase 1, D5–D7) ──────────────────────────────────────

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  passwordHash      String     @map("password_hash")
  fullName          String     @map("full_name")
  status            UserStatus @default(ACTIVE)
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  /// Base32 TOTP secret; set at enrolment, cleared on disable. Redacted in audit rows.
  mfaSecret         String?    @map("mfa_secret")
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at")
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until")
  /// Links a Taxpayer/Customer user to their payer record (FK added in phase 2).
  payerId           String?    @map("payer_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  roles           UserRole[]
  passwordHistory PasswordHistory[]
  refreshTokens   RefreshToken[]

  @@index([status])
  @@map("user")
}

/// Previous password hashes so a user cannot reuse the last N (D5).
model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

/// Opaque refresh tokens stored hashed; rotated on use, revoked on logout/reuse (D5).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  /// Set when the token was exchanged for a new one; presenting it again means theft.
  rotatedAt DateTime? @map("rotated_at")
  /// Set on logout, deactivation, password change or reuse detection.
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  /// A role inherits every permission of its parent, recursively (D6).
  parentId    String? @map("parent_id") @db.Uuid
  isSystem    Boolean @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent      Role?            @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Role[]           @relation("RoleHierarchy")
  permissions RolePermission[]
  users       UserRole[]

  @@index([parentId])
  @@map("role")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  /// `resource.action`, one row per code in @ircub/shared PERMISSIONS.
  code        String @unique
  description String
  group       String

  roles RolePermission[]

  @@index([group])
  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

/// A user may never hold both permissions, through any combination of roles (D7).
model SodRule {
  id              String   @id @default(uuid()) @db.Uuid
  permissionACode String   @map("permission_a_code")
  permissionBCode String   @map("permission_b_code")
  description     String
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([permissionACode, permissionBCode])
  @@map("sod_rule")
}

// ─── Audit (D8) ──────────────────────────────────────────────────────────────

/// Append-only, hash-chained record of every mutation of an audited model.
/// The API never updates or deletes rows; production hardening grants INSERT+SELECT only.
model AuditLog {
  id         BigInt      @id @default(autoincrement())
  /// Contiguous sequence allocated under the chain-head lock; the chain is verified in seq order.
  seq        BigInt      @unique
  actorId    String?     @map("actor_id") @db.Uuid
  actorEmail String      @map("actor_email")
  entity     String
  entityId   String      @map("entity_id")
  action     AuditAction
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")
  prevHash   String      @map("prev_hash") @db.Char(64)
  hash       String      @db.Char(64)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

/// Single row holding the tail of the chain; locked FOR UPDATE while a row is appended so
/// concurrent writers serialise and prevHash/seq stay consistent.
model AuditChainHead {
  id       Int    @id @default(1)
  lastSeq  BigInt @default(0) @map("last_seq")
  lastHash String @map("last_hash") @db.Char(64)

  @@map("audit_chain_head")
}

// ─── Foundation models ───────────────────────────────────────────────────────

/// Runtime-tunable business parameters (standards §1). Keys and typed defaults live in
/// apps/api/src/modules/system-config/system-config.keys.ts; the seed inserts the defaults.
model SystemConfig {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("system_config")
}

/// Single sequence shared by assessments and bills so a control number is unique across both
/// (D10). The row id becomes the 10-digit body; two mod-97 check digits are appended.
model ControlNumber {
  id        BigInt               @id @default(autoincrement())
  purpose   ControlNumberPurpose
  createdAt DateTime             @default(now()) @map("created_at")

  @@map("control_number")
}
