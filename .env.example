# ─── IRCUB POC environment ─────────────────────────────────────────────────────
# Copy to `.env` for local development. Every variable is validated at boot by
# apps/api/src/config/env.schema.ts; the API refuses to start on a missing or
# malformed value. Values shown are safe local defaults, NOT production values.

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | test | production. Controls log format (pretty vs JSON) and Swagger.
NODE_ENV=development
# Port the API listens on.
PORT=3000
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
# Host ports published by docker-compose.yml / docker-compose.test.yml. Change these if
# 5432/5433 are already taken; keep the URLs below in step.
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=5433
# Matches docker-compose.yml. For Neon paste the pooled URL exactly as Neon shows it.
DATABASE_URL=postgresql://ircub:ircub@localhost:5432/ircub?schema=public
# Throwaway database the e2e suite migrates and uses (docker-compose.test.yml).
TEST_DATABASE_URL=postgresql://ircub:ircub@localhost:5433/ircub_test?schema=public

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secrets for signing JWT access tokens and refresh tokens. Minimum 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-please-32chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-32c
# Token lifetimes in seconds (15 minutes / 7 days per docs/DECISIONS.md D5).
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ── Integrations ──────────────────────────────────────────────────────────────
# Base URL of the mock external services app (apps/mocks).
MOCKS_BASE_URL=http://localhost:3100
# Shared secret used to sign/verify payment callbacks (HMAC-SHA256). Must match apps/mocks.
MOCK_SHARED_SECRET=dev-only-shared-secret-change-me
# Delay before the mock channel posts a payment callback (apps/mocks only).
MOCK_CALLBACK_DELAY_MS=3000
# Port the mocks app listens on (apps/mocks only).
MOCKS_PORT=3100

# ── Web / CORS ────────────────────────────────────────────────────────────────
# Public URL the API is reachable at; used to build callback URLs given to the mock channels.
API_PUBLIC_URL=http://localhost:3000
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ── Containers only (docker-compose.yml, render.yaml; not read by the Nest app) ─
# Run the seed on container start when the database has no users yet.
SEED_ON_BOOT=true

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory for generated files (bill PDFs, uploaded CSVs). A volume in Docker Compose.
STORAGE_DIR=./storage

# ── Frontend (apps/web, read by Vite at build time) ───────────────────────────
# Base URL of the API as seen from the browser. Leave empty to use the nginx /api proxy.
VITE_API_URL=http://localhost:3000
