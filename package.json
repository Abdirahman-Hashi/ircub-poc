{
  "name": "ircub-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Integrated Revenue Collection & Utility Billing Platform — proof of concept",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -n shared,api,mocks,web -c gray,blue,magenta,green \"pnpm --filter @ircub/shared dev\" \"pnpm --filter api dev\" \"pnpm --filter mocks dev\" \"pnpm --filter web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm --filter @ircub/shared build && pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @ircub/shared build && pnpm --filter api test:e2e",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --filter @ircub/shared build && pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
